{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noImplicitAny": false,
    "esModuleInterop": true, "skipLibCheck": true, "allowJs": true, "checkJs": false, "jsx": "react-jsx",
    "types": ["node"], "lib": ["ES2022", "DOM", "DOM.Iterable"], "noEmit": true, "resolveJsonModule": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
