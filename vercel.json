{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install needed - bundles are prebuilt'",
  "buildCommand": "echo 'prebuilt'",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    },
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/for-nri-families",
      "destination": "/for-nri-families.html"
    },
    {
      "source": "/hospital-discharge-assistance-gurugram",
      "destination": "/hospital-discharge-assistance-gurugram.html"
    },
    {
      "source": "/opd-visit-companion-gurugram",
      "destination": "/opd-visit-companion-gurugram.html"
    },
    {
      "source": "/safety",
      "destination": "/safety.html"
    },
    {
      "source": "/track-lookup",
      "destination": "/track-lookup.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/ops",
      "destination": "/app.html"
    },
    {
      "source": "/ops/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/companion",
      "destination": "/app.html"
    },
    {
      "source": "/companion/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/track/:number",
      "destination": "/app.html"
    },
    {
      "source": "/pay/:id",
      "destination": "/app.html"
    },
    {
      "source": "/whatsapp",
      "destination": "/app.html"
    },
    {
      "source": "/demo",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/demo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/whatsapp",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pay/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/track/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/companion/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/companion",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ops/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ops",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/tick",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "sin1"
  ],
  "trailingSlash": false
}
